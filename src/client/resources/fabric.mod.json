{
  "schemaVersion": 1,
  "id": "threadium",
  "version": "${version}",
  "name": "Threadium",
  "description": "Accelerates eligible ModelPart entity rendering with safe GPU batching and automatic vanilla fallback.",
  "authors": [
    "AlexanderGG"
  ],
  "contact": {
    "homepage": "https://github.com/AlexanderGG-0520/threadium",
    "sources": "https://github.com/AlexanderGG-0520/threadium",
    "issues": "https://github.com/AlexanderGG-0520/threadium/issues"
  },
  "license": "MIT",
  "icon": "assets/threadium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.alex.threadium.ThreadiumClient"
    ],
    "modmenu": [
      "dev.alex.threadium.config.ThreadiumModMenuApi"
    ]
  },
  "mixins": [
    "threadium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.154.2+26.2",
    "minecraft": "26.2",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": ">=20.0.0-beta.4"
  }
}
